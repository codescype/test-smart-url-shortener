{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "lib": ["dom", "dom.iterable", "ESNext"],
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@tsus/shared-lib": ["../../libs/shared/src/index"],
      "@tsus/shared-lib/*": ["../../libs/shared/src/*"],
      "@tsus/server-app": ["../../apps/server/src/main"],
      "@tsus/server-app/*": ["../../apps/server/src/*"]
    },
    "baseUrl": ".",
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",

    "moduleResolution": "node"
  },
  "include": [
    "../../apps/client/.next/types/**/*.ts",
    "../../dist/apps/client/.next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "node_modules",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    ".next",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/shared/tsconfig.lib.json"
    },
    {
      "path": "../server/tsconfig.app.json"
    }
  ]
}
