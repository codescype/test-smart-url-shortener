{
  "name": "@tsus/shared-lib",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": "./src/*"
  },
  "engines": {
    "node": ">=v22.15.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
